{
  "$schema": "https://ayvago.com/schemas/manifest.v1.json",
  "id": "orbsurge",
  "title": {
    "en": "Orb Surge",
    "tr": "Orb Surge"
  },
  "description": {
    "en": "Launch magnetic orbs to collect glowing energy while dodging electromagnetic hazards. Every level is generated anew.",
    "tr": "Manyetik küreleri fırlat, parlayan enerjiyi topla ve elektromanyetik tehlikelerden kaç. Her seviye yeniden üretilir."
  },
  "category": "retro_action",
  "tags": [
    "arcade",
    "physics",
    "neon"
  ],
  "entry": "https://orb-surge.vercel.app/",
  "orientation": "any",
  "input": [
    "touch",
    "mouse"
  ],
  "players": {
    "min": 1,
    "max": 1
  },
  "scoring": {
    "metric": "points",
    "order": "desc",
    "format": "number",
    "label": {
      "en": "Score",
      "tr": "Puan"
    },
    "minDurationMs": 5000,
    "maxPerSecond": 250,
    "maxScore": 10000000
  },
  "ads": {
    "rewarded": [
      "continue"
    ],
    "interstitial": [
      "game_over"
    ]
  },
  "ageRating": "3+",
  "sdkVersion": 2,
  "assets": {
    "icon": "/ayvago/icon-512.png",
    "cover": "/ayvago/cover-1920x1080.jpg"
  },
  "version": "1.0.0"
}
